# ── Database ──
POSTGRES_DB=fn_licensing
POSTGRES_USER=fn_admin
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME

# ── Backend ──
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://fn_admin:CHANGE_ME@localhost:5432/fn_licensing?schema=public
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# ── JWT ──
JWT_SECRET=GENERATE_WITH_node_-e_"console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=GENERATE_WITH_node_-e_"console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── HWID ──
HWID_SALT=GENERATE_WITH_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX

# ── CORS ──
ADMIN_CORS_ORIGIN=https://admin.tondomain.com
STOREFRONT_CORS_ORIGIN=https://tondomain.com
STOREFRONT_URL=https://tondomain.com

# ── Rate Limiting ──
RATE_LIMIT_ACTIVATION=5
RATE_LIMIT_HEARTBEAT=60
RATE_LIMIT_ADMIN=100
BRUTE_FORCE_MAX_ATTEMPTS=10
BRUTE_FORCE_BLOCK_DURATION=600

# ── SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tonemail@gmail.com
SMTP_PASS=ton_app_password
SMTP_FROM=FortniteOpti <tonemail@gmail.com>

# ── Bot Discord ──
# Secret partagé avec le bot (header x-bot-secret)
BOT_API_SECRET=GENERATE_WITH_node_-e_"console.log(require('crypto').randomBytes(32).toString('hex'))"
# URL du serveur webhook interne du bot (pour les notifications de ventes)
BOT_WEBHOOK_URL=http://127.0.0.1:3001