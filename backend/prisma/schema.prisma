// ══════════════════════════════════════════════════════
//  FortniteOptimizer 2026 — Licensing System
//  Prisma Schema — PostgreSQL
// ══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum LicensePlan {
  DAYS_1
  DAYS_7
  DAYS_14
  DAYS_30
  DAYS_90
  DAYS_365
  LIFETIME
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  BANNED
  SUSPENDED
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  VIEWER
}

enum ActivationStatus {
  SUCCESS
  HWID_MISMATCH
  EXPIRED
  BANNED
  INVALID_KEY
  RATE_LIMITED
}

// ── Models ──

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  @@map("admins")
}

model License {
  id              String        @id @default(uuid()) @db.Uuid
  licenseKey      String        @unique @map("license_key") @db.VarChar(29)
  plan            LicensePlan
  status          LicenseStatus @default(ACTIVE)

  // HWID binding
  hwid            String?       @db.VarChar(64)
  hwidBoundAt     DateTime?     @map("hwid_bound_at")

  // User info
  email           String?       @db.VarChar(255)
  discordId       String?       @map("discord_id") @db.VarChar(50)

  // Stripe
  stripeSubId     String?       @map("stripe_sub_id") @db.VarChar(255)
  stripeCustomerId String?      @map("stripe_customer_id") @db.VarChar(255)

  // Dates
  createdAt       DateTime      @default(now()) @map("created_at")
  expiresAt       DateTime?     @map("expires_at")
  bannedAt        DateTime?     @map("banned_at")
  banReason       String?       @map("ban_reason")

  // Usage tracking
  lastHeartbeat   DateTime?     @map("last_heartbeat")
  activationCount Int           @default(0) @map("activation_count")
  maxActivations  Int           @default(1) @map("max_activations")
  lastIp          String?       @map("last_ip") @db.VarChar(45)

  // Metadata
  metadata        Json?

  // Relations
  activations     Activation[]
  logs            ActivationLog[]
  refreshTokens   RefreshToken[]

  @@index([licenseKey])
  @@index([hwid])
  @@index([status])
  @@index([expiresAt])
  @@map("licenses")
}

model Activation {
  id          String           @id @default(uuid()) @db.Uuid
  licenseId   String           @map("license_id") @db.Uuid
  hwid        String           @db.VarChar(64)
  ipAddress   String           @map("ip_address") @db.VarChar(45)
  machineInfo Json?            @map("machine_info")
  userAgent   String?          @map("user_agent") @db.VarChar(500)
  status      ActivationStatus
  createdAt   DateTime         @default(now()) @map("created_at")

  license     License          @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([hwid])
  @@index([createdAt])
  @@map("activations")
}

model ActivationLog {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  String?  @map("license_id") @db.Uuid
  action     String   @db.VarChar(50)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  license    License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([action])
  @@index([createdAt])
  @@map("activation_logs")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  licenseId  String   @map("license_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([licenseId])
  @@map("refresh_tokens")
}

model BlockedIp {
  id        String   @id @default(uuid()) @db.Uuid
  ipAddress String   @unique @map("ip_address") @db.VarChar(45)
  reason    String?  @db.VarChar(255)
  attempts  Int      @default(0)
  blockedAt DateTime @default(now()) @map("blocked_at")
  expiresAt DateTime @map("expires_at")

  @@index([ipAddress])
  @@index([expiresAt])
  @@map("blocked_ips")
}

// ── Customer (Storefront Users) ──

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String?   @map("display_name") @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  discordId    String?   @map("discord_id") @db.VarChar(50)

  // Status
  emailVerified Boolean  @default(false) @map("email_verified")
  banned        Boolean  @default(false)

  // Dates
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLogin    DateTime? @map("last_login")

  // Relations
  orders       Order[]

  @@index([email])
  @@index([username])
  @@map("customers")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  licenseId       String?     @map("license_id") @db.Uuid
  plan            LicensePlan
  amount          Int         // Price in cents
  currency        String      @default("EUR") @db.VarChar(3)
  status          OrderStatus @default(PENDING)

  // Stripe
  stripeSessionId String?     @map("stripe_session_id") @db.VarChar(255)
  stripePaymentId String?     @map("stripe_payment_id") @db.VarChar(255)

  // Dates
  createdAt       DateTime    @default(now()) @map("created_at")
  completedAt     DateTime?   @map("completed_at")

  // Relations
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([stripeSessionId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

