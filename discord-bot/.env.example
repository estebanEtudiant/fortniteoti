# ─────────────────────────────────────────────────
#  Bot Discord — variables d'environnement
# ─────────────────────────────────────────────────

# Token du bot (Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# ID de l'application Discord (pour enregistrer les commandes)
CLIENT_ID=your_client_id_here

# ID du serveur Discord (pour deploy en dev ; laisser vide = deploy global)
GUILD_ID=your_guild_id_here

# ─── Intégration backend FortniteOpti ───────────────
# URL de base de l'API backend
API_BASE_URL=http://localhost:3000/api/v1

# Secret partagé entre le bot et le backend (header x-bot-secret)
BOT_API_SECRET=change_me_strong_secret_here

# ─── Rôles Discord (IDs) ────────────────────────────
# Rôle attribué automatiquement à l'arrivée
ROLE_MEMBER=123456789012345678

# Rôles par plan de licence
ROLE_PLAN_DAYS_1=123456789012345678
ROLE_PLAN_DAYS_7=123456789012345678
ROLE_PLAN_DAYS_14=123456789012345678

# Rôle "muet" (permissions retirées dans tous les salons)
ROLE_MUTED=123456789012345678

# Rôle permettant d'utiliser les commandes de modération
ROLE_MODERATOR=123456789012345678

# ─── Salons Discord (IDs) ───────────────────────────
# Salon d'arrivée / départ des membres
CHANNEL_WELCOME=123456789012345678

# Catégorie où seront créés les tickets de support
CATEGORY_TICKETS=123456789012345678

# Salon de logs internes (ban, kick, warn…)
CHANNEL_LOGS=123456789012345678

# Salon de notifications de ventes (#ventes)
CHANNEL_SALES=123456789012345678

# Salon de backup quotidien (privé staff)
CHANNEL_BACKUP=123456789012345678

# ─── Status Monitor ─────────────────────────────────
# URL du storefront à surveiller
STOREFRONT_URL=http://localhost:3002

# URL du lien de téléchargement à surveiller (laisser vide pour désactiver)
DOWNLOAD_URL=https://ton-hebergeur.com/setup.exe

# Intervalle de mise à jour du statut (ms, défaut 60s)
STATUS_INTERVAL_MS=60000

# ─── Webhook interne (notif ventes backend → bot) ───
# Port sur lequel le bot écoute les notifications du backend
WEBHOOK_PORT=3001
# Taille max du payload webhook en octets
WEBHOOK_MAX_BODY_BYTES=16384

# ─── Auto-modération ─────────────────────────────────
# Nb de messages avant mute automatique (sur AUTOMOD_SPAM_WINDOW_MS ms)
AUTOMOD_SPAM_THRESHOLD=5
AUTOMOD_SPAM_WINDOW_MS=5000

# ─── Divers ─────────────────────────────────────────
# Chemin vers le fichier de base de données SQLite
DB_PATH=./data/bot.sqlite

# Niveau de log : error | warn | info | debug
LOG_LEVEL=info
